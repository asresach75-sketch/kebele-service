# Copy these settings into backend/.env. Use a verified sender domain for delivery
# to users; Resend's onboarding sender only works for the account's verified recipient.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL="E-Kebele Portal <password-reset@your-verified-domain.example>"
# Set this to the exact public or local origin where the frontend is served.
FRONTEND_URL=http://localhost:3001
PORT=5000
