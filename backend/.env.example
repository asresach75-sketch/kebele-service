ተጠቃሚዎች (ወይም ኦፊሰሮች) በፖርታሉ ላይ የሚጫኗቸውን ዎች (እንደ PDF ወይም ፎቶዎች ያሉ ሰነዶች) በቀጥታ በብሮውዘር ውስጥ ማየት እንዲችሉ (In-browser Preview / PDF Reader) ማድረግ ይቻላል።

ይህን ባህሪ በ React ኮድዎ ውስጥ ለመጨመር የሚከተሉትን ሁለት መንገዶች መጠቀም ይችላሉ፦

1. የሰነድ ማሳያ ሞዳል (Document Viewer Modal)
ሰነዱ ሲጫን ወይም "Open original" የሚለው አዝራር ሲጫን ፋይሉን አዲስ ታብ (New Tab) ላይ እንዲከፍት ወይም በ ሞዳል (Modal) ውስጥ በ <iframe> ወይም <embed> ታግ እንዲታይ ማድረግ ይቻላል።

JavaScript
import React, { useState } from 'react';

function DocumentViewer({ fileUrl, fileName }) {
  const [isOpen, setIsOpen] = useState(false);

  return (
    <div>
      {/* ሰነዱን ለመክፈት የሚረዳ አዝራር */}
      <button 
        type="button"
        onClick={() => setIsOpen(true)}
        className="text-blue-600 underline text-sm hover:text-blue-800"
      >
        Open original ({fileName || 'Document'})
      </button>

      {/* ሞዳል (Modal) ሰነዱን ለማሳየት */}
      {isOpen && (
        <div className="fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
          <div className="bg-white w-full max-w-4xl h-[80vh] rounded-lg flex flex-col overflow-hidden shadow-2xl">
            
            {/* የሞዳል ራዕይ (Header) */}
            <div className="bg-blue-900 text-white px-4 py-3 flex justify-between items-center">
              <h3 className="font-medium">የሰነድ ማሳያ / Document Preview</h3>
              <button 
                onClick={() => setIsOpen(false)}
                className="text-white font-bold text-lg hover:text-gray-300"
              >
                ✕
              </button>
            </div>

            {/* የሰነዱ ማሳያ አካል (Viewer Body) */}
            <div className="flex-1 bg-gray-100 p-2 overflow-auto">
              {fileUrl.endsWith('.pdf') ? (
                <iframe 
                  src={fileUrl} 
                  title="PDF Viewer" 
                  className="w-full h-full rounded border"
                />
              ) : (
                <img 
                  src={fileUrl} 
                  alt="Document Preview" 
                  className="max-w-full max-h-full mx-auto object-contain rounded"
                />
              )}
            </div>

            {/* የግርጌ አዝራር */}
            <div className="bg-gray-50 px-4 py-3 flex justify-end gap-2 border-t">
              <a 
                href={fileUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                className="bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700"
              >
                በሌላ ታብ ክፈት (Open in New Tab)
              </a>
              <button 
                onClick={() => setIsOpen(false)}
                className="bg-gray-300 text-gray-800 px-4 py-2 rounded text-sm hover:bg-gray-400"
              >
                ዝጋ (Close)
              </button>
            </div>

          </div>
        </div>
      )}
    </div>
  );
}

export default DocumentViewer;
2. በባለቤቱ ኮድ ውስጥ እንዴት ማካተት ይቻላል?
በኦፊሰር ዳሽቦርድዎ ላይ ያሉት ሰነዶች (ለምሳሌ ID Photo ወይም Birth Certificate) የ URL አድራሻቸውን ወደዚህ DocumentViewerኮምፖነንት በመላክ ተጠቃሚዎች ያለ ምንም ችግር ፒዲኤፎችን እና ፎቶዎችን በቀጥታ በሲስተሙ ውስጥ ማንበብ እና ማየት እንዲችሉ ማድረግ ይችላሉ።

ይህንን ባህሪ ከየትኛው የፕሮጀክትዎ ክፍል ጋር ማዋሃድ ይፈልጋሉ?# Backend server and local MongoDB defaults
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ekebele_db
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# SMTP settings for automated application, payment, and collection emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="E-Kebele Portal <your-email@gmail.com>"

# Public website URL embedded in completed-document QR codes
# The frontend URL embedded in ID-card verification QR codes. For phone scanning,
# use a public URL or a LAN-reachable URL (for example http://192.168.1.20:3001),
# not localhost, then restart the backend and generate/download the card again.
PUBLIC_APP_URL=http://localhost:3001

